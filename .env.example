# -----------------------------------------------------------------------------
# 应用基础配置
# -----------------------------------------------------------------------------
# 应用名称（用于日志、邮件、界面展示等）
APP_NAME=Laravel
# 运行环境：local / testing / production
APP_ENV=local
# 应用加密密钥（每个环境需独立生成）
APP_KEY=
# 是否开启调试（生产环境必须为 false）
APP_DEBUG=true
# 服务对外访问地址
APP_URL=http://localhost
# 可选：自定义日志目录；留空则使用 Laravel 默认 storage/logs
APP_LOG_PATH=

# -----------------------------------------------------------------------------
# 国际化配置
# -----------------------------------------------------------------------------
# 默认语言
APP_LOCALE=en_US
# 缺失翻译时的回退语言
APP_FALLBACK_LOCALE=en_US
# Faker 生成测试数据时使用的语言区域
APP_FAKER_LOCALE=en_US

# -----------------------------------------------------------------------------
# 维护模式配置
# -----------------------------------------------------------------------------
# 维护模式驱动
APP_MAINTENANCE_DRIVER=file
# 维护状态存储位置
APP_MAINTENANCE_STORE=database

# -----------------------------------------------------------------------------
# 日志配置
# -----------------------------------------------------------------------------
# 主日志通道及日志栈
LOG_CHANNEL=stack
LOG_STACK=single
# 废弃告警日志通道（null 表示不单独输出）
LOG_DEPRECATIONS_CHANNEL=null
# 日志级别：debug / info / warning / error
LOG_LEVEL=debug

# -----------------------------------------------------------------------------
# 数据库配置（MySQL 读写分离）
# -----------------------------------------------------------------------------
# 默认数据库连接标识
DB_CONNECTION=blockmatrix
# 读库节点
MYSQL_READ_HOST=127.0.0.1
MYSQL_READ_PORT=3306
MYSQL_READ_USERNAME=root
MYSQL_READ_PASSWORD=
# 写库节点
MYSQL_WRITE_HOST=127.0.0.1
MYSQL_WRITE_PORT=3306
MYSQL_WRITE_USERNAME=root
MYSQL_WRITE_PASSWORD=
# 可选：MySQL SSL CA 证书路径
MYSQL_ATTR_SSL_CA=
# 业务时区偏移（部分业务逻辑会读取）
ZONETOTIME=+0:00

# -----------------------------------------------------------------------------
# 会话配置
# -----------------------------------------------------------------------------
# 会话驱动（多节点建议使用 redis）
SESSION_DRIVER=redis
# 会话有效期（分钟）
SESSION_LIFETIME=120
# 是否加密会话内容
SESSION_ENCRYPT=false
# 可选：自定义会话 Cookie 名称/路径/域
SESSION_COOKIE=session_id
SESSION_PATH=/
SESSION_DOMAIN=null

# -----------------------------------------------------------------------------
# 运行基础设施
# -----------------------------------------------------------------------------
# 广播 / 文件存储 / 队列驱动
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

# 缓存驱动与前缀
CACHE_STORE=file
CACHE_PREFIX=

# -----------------------------------------------------------------------------
# Redis 配置
# -----------------------------------------------------------------------------
# Redis 客户端实现
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
# 逻辑库分配（用于隔离业务缓存）
REDIS_DB=0
REDIS_CACHE_DB=1

# -----------------------------------------------------------------------------
# 邮件配置
# -----------------------------------------------------------------------------
# 邮件传输配置
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# -----------------------------------------------------------------------------
# AWS / 对象存储
# -----------------------------------------------------------------------------
# 敏感凭据：仅通过安全环境管理注入，不入库
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# -----------------------------------------------------------------------------
# 业务与安全控制项
# -----------------------------------------------------------------------------
# CORS 白名单（如支持多域名可按解析规则逗号分隔）
CORS_ALLOWED_ORIGINS=http://127.0.0.1:8000
# 验证码开关（生产环境非审批场景不得关闭）
NO_CAPTCHA=false
# 系统级高权限角色 ID
ROOT_ROLES=[1]

# 异常与业务通知邮箱组
EXCEPTION_EMAIL=
REPORT_EMAIL=
MEDIA_EMAIL=
CONTEST_EMAIL=
FRIEND_EMAIL=

# -----------------------------------------------------------------------------
# API 与下游集成配置
# -----------------------------------------------------------------------------
# 对外 API 版本标识
API_VERSION=0.0.1
# Scramble 文档 Basic Auth（密码至少 8 位，且不能和用户名相同）
SCRAMBLE_DOCS_USERNAME=
SCRAMBLE_DOCS_PASSWORD=

# gRPC 地址
GRPC_LIVE_URL=
GRPC_TRIAL_URL=
# 未显式配置时，Flux 默认读取 GRPC_LIVE_URL
FLUX_GRPC_HOST="${GRPC_LIVE_URL}"
FLUX_VAULT_TOPIC=flux-vault-events

# 可选：消息中间件地址
KAFKA_BROKERS=
# php-common 中所有表模型事件的消费者配置
KAFKA_MODEL_EVENT_TOPIC=php-common
KAFKA_MODEL_EVENT_GROUP_ID=backend-crm-model-event
# 首次部署时从最新事件开始；如需回放历史事件可改为 earliest
KAFKA_MODEL_EVENT_AUTO_OFFSET_RESET=latest

# 支付回调地址（需与第三方白名单一致）
MEPAY_CALL_BACK=

# -----------------------------------------------------------------------------
# 前端构建变量
# -----------------------------------------------------------------------------
VITE_APP_NAME="${APP_NAME}"
